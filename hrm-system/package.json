    "start:employee": "npm run build && node dist/employee-main.js",
    "start:leave": "npm run build && node dist/leave-main.js",
    "start:attendance": "npm run build && node dist/attendance-main.js",
    "start:payroll": "npm run build && node dist/payroll-main.js",
    "dev": "tsx watch src/main.ts",
    "dev:core": "tsx watch src/main.ts",
    "dev:gateway": "tsx watch src/gateway-main.ts",
    "dev:email": "tsx watch src/email-main.ts",
    "dev:config": "tsx watch src/config-main.ts",
    "dev:identity": "tsx watch src/identity-main.ts",
    "dev:employee": "tsx watch src/employee-main.ts",
    "dev:leave": "tsx watch src/leave-main.ts",
    "dev:attendance": "tsx watch src/attendance-main.ts",
