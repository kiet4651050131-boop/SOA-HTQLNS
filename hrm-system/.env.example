PORT=3000
GATEWAY_HOST=0.0.0.0
GATEWAY_TRUST_PROXY=
CORE_PORT=3100
CORE_HOST=127.0.0.1
CORE_SERVICE_URL=http://127.0.0.1:3100
GATEWAY_TIMEOUT_MS=5000
EMAIL_PORT=3200
EMAIL_HOST=127.0.0.1
EMAIL_SERVICE_URL=http://127.0.0.1:3200
EMAIL_SERVICE_TIMEOUT_MS=20000
NOTIFICATION_SERVICE_TIMEOUT_MS=3000
CONFIG_PORT=3300
CONFIG_HOST=127.0.0.1
CONFIG_SERVICE_URL=http://127.0.0.1:3300
CONFIG_SERVICE_TIMEOUT_MS=3000
IDENTITY_PORT=3001
IDENTITY_HOST=127.0.0.1
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
IDENTITY_SERVICE_TIMEOUT_MS=3000
EMPLOYEE_PORT=3002
EMPLOYEE_HOST=127.0.0.1
EMPLOYEE_SERVICE_URL=http://127.0.0.1:3002
EMPLOYEE_SERVICE_TIMEOUT_MS=3000
# Production: random secret >= 32 bytes. Development can leave this blank.
INTERNAL_SERVICE_TOKEN=
# Chi Identity Service giu secret nay; chuoi ngau nhien dai >= 32 ky tu
JWT_SECRET=
# production: bat buoc co JWT_SECRET
NODE_ENV=development
# Duong dan file CSDL rieng cua HRM Core Service (mac dinh ./data/hrm.db)
DB_FILE=
# Duong dan file CSDL rieng cua Email Service (mac dinh ./data/email.db)
EMAIL_DB_FILE=
# Duong dan file CSDL rieng cua Config Service (mac dinh ./data/config.db)
CONFIG_DB_FILE=
# Duong dan file CSDL rieng cua Identity Service (mac dinh ./data/identity.db)
IDENTITY_DB_FILE=
# Duong dan file CSDL rieng cua Employee Service (mac dinh ./data/employee.db)
EMPLOYEE_DB_FILE=
# Mui gio dung cho cham cong (mac dinh Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh
# SMTP gui email khoi phuc mat khau (Gmail can dung App Password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
APP_URL=http://localhost:3000
